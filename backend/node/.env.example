# Só para rodar fora do Docker (o caminho padrão é o Compose, que já define tudo isso).
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://app_runtime:app_runtime@localhost:5432/app
MIGRATION_DATABASE_URL=postgresql://app:app@localhost:5432/app
APP_DB_USER=app_runtime
APP_DB_PASSWORD=app_runtime
DEMO_IDENTITY_ENABLED=true
